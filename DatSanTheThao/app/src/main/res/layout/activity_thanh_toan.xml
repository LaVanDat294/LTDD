<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7F4"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F5B34"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvQuayLaiTT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="14dp"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="XÁC NHẬN &amp; THANH TOÁN"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llDemNguoc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#DFF5E6"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đơn của bạn còn được giữ chỗ trong"
            android:textColor="#0F5B34"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDemNguoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="05:59"
            android:textColor="#0F5B34"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏟️ Thông tin lịch đặt sân"
                    android:textColor="#0F5B34"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvThongTinDonTT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Chi tiết đơn..."
                    android:textColor="#222222"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤 Thông tin người đặt"
                    android:textColor="#0F5B34"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtTenKhachTT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F5F7F6"
                    android:hint="Tên của bạn"
                    android:padding="10dp"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edtSdtKhachTT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F5F7F6"
                    android:hint="Số điện thoại liên hệ"
                    android:inputType="phone"
                    android:padding="10dp"
                    android:text="0335456405"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edtGhiChuTT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F5F7F6"
                    android:hint="Ghi chú cho chủ sân (vd: mượn bóng, áo tập...)"
                    android:padding="10dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💳 Phương thức thanh toán"
                    android:textColor="#0F5B34"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgPhuongThuc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbTienMat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="💵 Tiền mặt (Thanh toán trực tiếp tại sân)"
                        android:textColor="#222222"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbChuyenKhoan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏦 Chuyển khoản ngân hàng (Quét mã QR)"
                        android:textColor="#0F5B34"
                        android:textStyle="bold" />
                </RadioGroup>

                <TextView
                    android:id="@+id/tvHuongDanTienMat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#FFF8E1"
                    android:padding="10dp"
                    android:text="⚠️ Quý khách vui lòng có mặt trước 10 phút và thanh toán tiền mặt trực tiếp tại quầy lễ tân của sân."
                    android:textColor="#795548"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/llKhungChuyenKhoan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F1F8F4"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/flKhungQr"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:background="#FFFFFF"
                            android:padding="6dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvChuTkTT"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CHỦ TK"
                                android:textColor="#111111"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSoTkTT"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Số TK: ..."
                                android:textColor="#0F5B34"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvNganHangTT"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Ngân hàng: ..."
                                android:textColor="#444444"
                                android:textSize="13sp" />

                            <Button
                                android:id="@+id/btnCopyStk"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginTop="6dp"
                                android:backgroundTint="#0F5B34"
                                android:text="📋 Sao chép STK"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNoiDungCkTT"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="#FFFFFF"
                        android:padding="8dp"
                        android:text="Nội dung CK: DATSAN"
                        android:textColor="#D84315"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tổng thanh toán:"
                android:textColor="#333333"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTongTienTT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 đ"
                android:textColor="#0F5B34"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llCumNutHanhDong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHuyDonChiTiet"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#FFEBEE"
                android:text="✕ Hủy đơn"
                android:textColor="#C62828"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnXacNhanThanhToan"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.8"
                android:backgroundTint="#0F5B34"
                android:text="✓ Xác nhận đặt sân"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>