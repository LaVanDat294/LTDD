<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTieuDeThemSan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="THÔNG TIN SÂN BÓNG &amp; HÌNH ẢNH"
            android:textColor="#0F5B34"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtTenSan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:hint="Tên sân (vd: Sân bóng Thành Công)"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtLoaiSan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:hint="Loại sân (5, 7, 11 người)"
            android:inputType="number"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtSoSan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:hint="Số sân con (vd: 4)"
            android:inputType="number"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtDiaChi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:hint="Địa chỉ sân"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtSdt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:hint="Số điện thoại liên hệ"
            android:inputType="phone"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtGia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:hint="Giá thuê mỗi giờ (VNĐ)"
            android:inputType="number"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtGioMo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:hint="Giờ mở cửa (vd: 6)"
            android:inputType="number"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtGioDong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF"
            android:hint="Giờ đóng cửa (vd: 22)"
            android:inputType="number"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtTienIch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:hint="Tiện ích, cách nhau dấu phẩy (Wifi, Toilet,...)"
            android:padding="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏟️ Hình ảnh thực tế của sân (chọn được nhiều ảnh):"
                android:textColor="#0F5B34"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnChonAnhSan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E8F5E9"
                android:text="+ Chọn hình ảnh sân từ thư viện"
                android:textColor="#0F5B34" />

            <HorizontalScrollView
                android:id="@+id/hsvAnhSanPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llAnhSanPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvTrangThaiAnhSan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Chưa có ảnh sân (Bấm vào ảnh đã chọn để xóa)"
                android:textColor="#757575"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="#FFFFFF"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📷 Ảnh mã QR chuyển khoản của sân:"
                android:textColor="#0F5B34"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnChonAnhQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E8F5E9"
                android:text="Chọn ảnh QR từ thư viện máy"
                android:textColor="#0F5B34" />

            <ImageView
                android:id="@+id/imgQrPreview"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_marginTop="10dp"
                android:background="#F5F7F6"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTrangThaiAnhQr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Chưa tải ảnh QR lên"
                android:textColor="#757575"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLuuSan"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#0F5B34"
            android:text="LƯU THÔNG TIN SÂN"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>