<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#0F5B34"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚽ ĐẶT SÂN BÓNG ĐÁ"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Hệ thống đặt sân trực tiếp không cần mạng"
                android:textColor="#C8E6C9"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chọn vai trò đăng nhập:"
            android:textColor="#1B4332"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgVaiTro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbKhach"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Khách đặt sân"
                android:textColor="#0F5B34"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbChuSan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chủ sân bóng"
                android:textColor="#1565C0"
                android:textStyle="bold" />
        </RadioGroup>

        <EditText
            android:id="@+id/edtHoTen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:hint="Họ và tên (chỉ nhập khi Đăng ký)"
            android:padding="14dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/edtUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:hint="Tên đăng nhập (vd: khach hoặc chusan)"
            android:padding="14dp"
            android:text="khach" />

        <EditText
            android:id="@+id/edtPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:hint="Mật khẩu (mặc định: 123)"
            android:inputType="textPassword"
            android:padding="14dp"
            android:text="123" />

        <Button
            android:id="@+id/btnDangNhap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#0F5B34"
            android:padding="14dp"
            android:text="ĐĂNG NHẬP"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCheDoDangKy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#E8F5E9"
            android:padding="12dp"
            android:text="Chưa có tài khoản? Đăng ký mới Offline"
            android:textColor="#0F5B34" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:text="Tài khoản có sẵn trong máy:\n• Khách hàng: khach / 123\n• Chủ sân: chusan / 123"
            android:textColor="#555555"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>