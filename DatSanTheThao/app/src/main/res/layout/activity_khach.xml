<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F5"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/llNoiDungTab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabTrangChu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🏠\nTrang chủ"
            android:textColor="#0F5B34"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabBanDo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📍\nBản đồ"
            android:textColor="#757575"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tabKhamPha"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🧭\nKhám phá"
            android:textColor="#757575"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tabNoiBat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🔥\nNổi bật"
            android:textColor="#757575"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tabTaiKhoan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👤\nTài khoản"
            android:textColor="#757575"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>